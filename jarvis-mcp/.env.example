# Obligatorio. Generar con: python -c "import secrets;print(secrets.token_urlsafe(32))"
JARVIS_TOKEN=

# Notificaciones (opcionales, usá una o ambas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=

# Tareas que Jarvis puede listar/ejecutar (las define Pablo; ver tareas.ejemplo.json)
JARVIS_TASKS=tareas.json
# Carpeta de scripts que una tarea tipo "script" puede correr (solo por nombre)
JARVIS_SCRIPTS=scripts
JARVIS_TASK_TIMEOUT=60

# Interfaz donde escucha (127.0.0.1 = solo esta PC; usar la IP de Tailscale o 0.0.0.0 para acceso remoto)
JARVIS_HOST=127.0.0.1

# Ruta de la base SQLite
JARVIS_DB=jarvis.db

# Conexión a casa-servidor (Fase 3). El usuario se crea con:
#   python casa_servidor.py alta-persona jarvis --rol basico --canal agente --cmd riego,luces
# (canal "agente": el servidor le aplica la política y Jarvis no puede confirmar acciones)
CASA_HOST=127.0.0.1
CASA_PORT=8883
CASA_CA=datos/ca.crt
CASA_USUARIO=
CASA_CLAVE=
# Eventos que además avisan por Telegram/webhook (separados por coma). Las desconexiones de módulos avisan siempre.
CASA_AVISAR_EVENTOS=cmd_sin_respuesta

# Voz y texto (puente de voz): token SOLO para POST /voz. Generar uno distinto al JARVIS_TOKEN.
JARVIS_VOZ_TOKEN=

# Conversación con modelo de lenguaje (Gemini, nivel gratuito). Apagado por defecto: el texto sale a internet.
# La clave se saca en https://aistudio.google.com (Get API key). Nunca la subas a un repo.
JARVIS_GEMINI_KEY=
JARVIS_GEMINI_MODEL=gemini-2.5-flash
JARVIS_INTERNET_TEXTO=0
# 1 = además del texto, manda a Gemini el estado actual de la casa para que pueda contestar sobre ella
JARVIS_ENVIAR_ESTADO_CASA=0
# Tope diario de consultas (cuidar el cupo gratuito)
JARVIS_GEMINI_MAX_DIA=100
